# Firebase Configuration
# Get these values from Firebase Console: Project Settings > Your Apps > Web
# Steps:
# 1. Go to https://console.firebase.google.com
# 2. Select your project
# 3. Go to Project Settings (gear icon)
# 4. Go to "Your Apps" tab
# 5. Select your Web app
# 6. Copy all the values below

VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890ab

# Gemini API Configuration
# Steps:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key below

VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# App Configuration
# Usually no need to change these
VITE_APP_ID=analisis-soal-v1
